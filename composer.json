{
    "name": "uma/slim-doctrine-demo",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "UMA\\DoctrineDemo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UMA\\Tests\\DoctrineDemo\\": "tests/"
        }
    },
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-json": "*",
        "ext-sqlite3": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/orm": "^3.7",
        "fakerphp/faker": "^1.24",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "slim/slim": "^4.15",
        "symfony/cache": "^8.1",
        "uma/dic": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "roave/security-advisories": "dev-master"
    },
    "scripts": {
        "serve": [
            "@composer install",
            "./bin/doctrine orm:schema-tool:update --force",
            "php -S localhost:8000 -t public public/index.php"
        ],
        "test": [
            "php vendor/bin/phpunit"
        ]
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
